{
  "name": "company-registry-filings-aggregator",
  "version": "1.0.0",
  "description": "Apify Actor for official company registry and SEC filing data from public APIs.",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "start": "node dist/main.js",
    "build": "node ./node_modules/typescript/bin/tsc",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "npm run build && node --test dist/audit.test.js",
    "audit:prod": "node scripts/audit-production.mjs"
  },
  "dependencies": {
    "apify": "^3.2.5"
  },
  "devDependencies": {
    "@apify/tsconfig": "^0.1.0",
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
